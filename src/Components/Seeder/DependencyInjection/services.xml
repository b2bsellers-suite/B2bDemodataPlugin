<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>


        <service id="B2bDemodata\Components\Seeder\Seeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\CategorySeeder"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\CustomerSeeder"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\ProductSeeder"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\ProductListSeeder"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\EventSeeder"/>
            <argument type="service" id="B2bDemodata\Components\Seeder\Seeds\OrderSeeder"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\CategorySeeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\CustomerSeeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\ProductSeeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\ProductListSeeder">
            <argument type="service" id="b2bsellers_product_list.repository" on-invalid="null"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\OrderSeeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="customer.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="b2bsellers_employee.repository"/>
            <argument type="service" id="payment_method.repository"/>
            <argument type="service" id="shipping_method.repository"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\Loader\InitialStateIdLoader"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Seeds\EventSeeder">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="B2bDemodata\Components\Seeder\Subscriber\MapCustomerData">
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
